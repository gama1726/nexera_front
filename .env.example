# Public site URL (SEO / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API — used by Next.js rewrites (/api/*, /media/*) and server-side fetch.
# Point at local nexera_back or the internal API URL in production.
API_INTERNAL_URL=http://localhost:8080

# Optional: absolute API base for the browser. Prefer empty + rewrites so
# lead POST stays same-origin (correct client IP for rate limiting).
# NEXT_PUBLIC_API_BASE=
